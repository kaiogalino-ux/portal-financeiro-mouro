# PostgreSQL (usado pelo Prisma). Ao rodar via Docker Compose, use o host "db".
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal_financeiro?schema=public

# Auth.js (NextAuth v5) — gere um valor com: npx auth secret
AUTH_SECRET=coloque_um_valor_aleatorio_aqui
AUTH_URL=http://localhost:3000

# Camada de integração com o ERP: "mock" (dados simulados) ou "gestaoclick"
# (API real do Gestão Click — precisa das duas variáveis abaixo).
ERP_ADAPTER=mock

# Só usados quando ERP_ADAPTER=gestaoclick. Mesmas credenciais já validadas
# em ../.env (fora de portal/) — nunca commitar valores reais aqui.
GESTAOCLICK_ACCESS_TOKEN=
GESTAOCLICK_SECRET_ACCESS_TOKEN=

# Senha inicial dos usuários criados por `npm run db:seed` e
# `npm run db:bootstrap-real`. Fica só aqui (o `.env` nunca é versionado) —
# o repositório é público, então senha em texto no código vira senha
# publicada. Sem esta variável os dois scripts falham de propósito, em vez de
# criar usuários com uma senha padrão conhecida. Depois de criado, troque a
# senha de cada usuário pela tela de Usuários no portal.
SEED_PASSWORD=

# Janela padrão (em dias) usada pela sincronização quando nenhum período é
# informado manualmente na página "Sincronizações". Para pagamentos/recebimentos,
# a API do Gestão Click só filtra títulos em aberto pela data de vencimento —
# uma janela curta deixa de fora títulos vencidos há muito tempo ou agendados
# bem no futuro, fazendo "Total a pagar/receber" ficar incompleto. Valores
# largos (20 anos atrás / 10 anos à frente) garantem cobertura total; ajuste
# para baixo só se o volume de dados da empresa for grande e a sincronização
# ficar lenta.
SYNC_LOOKBACK_DAYS=7300
SYNC_LOOKAHEAD_DAYS=3650

# Taxa (0 a 1) de falhas simuladas injetadas pelo MockErpAdapter, só para
# exercitar o retry/erro do orquestrador de sincronização. Deixe 0 em uso normal.
MOCK_ERP_FAILURE_RATE=0

# URL pública do portal, usada na página "Integrações" e como `servers` da
# especificação OpenAPI (/api/v1/openapi.json). Só é necessária quando o
# portal estiver publicado — ChatGPT, Telegram e WhatsApp chamam a API de
# fora e não alcançam localhost. Sem ela, cai em AUTH_URL.
PORTAL_PUBLIC_URL=

# --- Consumidor da API (MCP), não o servidor ---
# Usadas por `npm run mcp` (mcp/portalFinanceiroMcp.mjs), que consome a
# própria API do portal. O token é uma chave criada em Integrações no portal.
PORTAL_API_URL=http://localhost:3000
PORTAL_API_TOKEN=
